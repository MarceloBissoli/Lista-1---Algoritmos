#include <iostream>
using namespace std;

int main (){
	//declaração de variaveis;
	float x;
	char escolha;
	
	//Entrada do valor de x;
	do{
	cout<<"Digite o valor de X:";
	cin>>x;
	
	//condicionais de X para impressão de F(x);
	if (x<=1){
		cout<<"Funcao de X = 1"; //imprimir 1 se X for menor ou igual a 1;
	}
	else if (x>1 and x<=2){
		cout<<"Funcao de X = 2"; //imprimir 2 se X for maior que 1 e igual ou menor a 2;
	}
	else if (x>2 and x<=3){
		cout<<"Funcao de X = " <<x*x; //imprimir X ao quadrado se ele for maior que dois e igual ou menor a 3;
	}
	else {
		cout<<"Funcao de X = " <<x*x*x; //Imprimir X ao cubo se ele for maior que 3;
	}
	
	//Reprocessamento de código de acordo com a escolha do user;
	cout<<"\nDeseja realizar uma nova operacao?(S/N)\nEscolha:";
	cin>>escolha;
	
	}while (escolha=='S'or escolha=='s');
	
	//Encerramento do programa se a escolha for n ou N;
	if (escolha=='N'or escolha=='n'){
		cout<<"Programa Encerrado!";
	}
	
	return 0;
}
